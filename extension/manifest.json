{
  "manifest_version": 3,
  "name": "即時會議翻譯 - MeetTranslate",
  "version": "3.5.1",
  "description": "即時翻譯 Google Meet 與 Zoom 會議：雙欄即時雙向翻譯、30+ 語言、關鍵詞、音訊檔翻譯與雙語 AI 會議記錄",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "mic-permission.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
